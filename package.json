{
  "name": "bingenz-commerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml",
    "test": "node --test tests/*.test.mjs",
    "audit:simulations": "node scripts/audit-simulations.mjs",
    "prepare:admin-upload": "node scripts/prepare-admin-upload.mjs",
    "test:protected": "node scripts/test-protected-simulations.mjs",
    "deploy:preview": "wrangler deploy --config wrangler.preview.toml",
    "migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml",
    "migrate:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview.toml"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "html-minifier-terser": "7.2.0",
    "linkedom": "0.18.12",
    "miniflare": "5.20260915.0-alpha",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "wrangler": "4.132.0"
  },
  "dependencies": {
    "jose": "6.1.3"
  }
}
